// Generated by gpu-dialect from Rust syntax. Slang is the compiler backend.

bool __gust_not(bool value) { return !value; }
int __gust_not(int value) { return ~value; }
uint __gust_not(uint value) { return ~value; }

[[vk::binding(0, 0)]] StructuredBuffer<float> values;
[[vk::binding(1, 0)]] RWStructuredBuffer<float> floats;
[[vk::binding(2, 0)]] RWStructuredBuffer<uint> integers;

float score(float x)
{
    if ((x > float(0.0)))
    {
        return ((x * float(2.5)) + float(1.0));
    }
    else     if ((x < float(0.0)))
    {
        return (-x);
    }
    else
    {
        return float(7.0);
    }
}

uint mask(uint x)
{
    uint divisor = 2;
    uint quotient = (x / divisor);
    (quotient += uint(1));
    if (((x & uint(1)) == uint(0)))
    {
        return ((((__gust_not(x) & uint(255))) + uint(2)) + quotient);
    }
    else
    {
        return (x + uint(1024));
    }
}

// @rust kernel: semantics::run
[shader("compute")]
[numthreads(64, 1, 1)]
void gpu_semantics_run(uint3 id : SV_DispatchThreadID)
{
    uint __gpu_len_values;
    uint __gpu_stride_values;
    values.GetDimensions(__gpu_len_values, __gpu_stride_values);
    uint __gpu_len_floats;
    uint __gpu_stride_floats;
    floats.GetDimensions(__gpu_len_floats, __gpu_stride_floats);
    uint __gpu_len_integers;
    uint __gpu_stride_integers;
    integers.GetDimensions(__gpu_len_integers, __gpu_stride_integers);
    uint i = id.x;
    if ((i < __gpu_len_floats))
    {
        floats[i] = score(values[i]);
        integers[i] = mask(i);
        if (__gust_not(((i < uint(2)))))
        {
            (floats[i] += float(1.0));
        }
    }
}
