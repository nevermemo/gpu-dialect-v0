{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GUST: check fast",
      "type": "shell",
      "command": "cargo xtask check-fast",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "GUST: check feature",
      "type": "shell",
      "command": "cargo xtask check-feature ${input:gustFeatureArea}",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "GUST: check examples",
      "type": "shell",
      "command": "cargo xtask check-examples",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "GUST: check artifacts",
      "type": "shell",
      "command": "cargo xtask check-artifacts",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "GUST: check full",
      "type": "shell",
      "command": "cargo xtask check-full",
      "group": "test",
      "problemMatcher": "$rustc"
    }
  ],
  "inputs": [
    {
      "id": "gustFeatureArea",
      "type": "pickString",
      "description": "Focused GUST check area",
      "options": ["macro", "core", "wgpu", "reflection", "loops", "examples", "artifacts", "full"],
      "default": "macro"
    }
  ]
}
