{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GUST: check fast",
      "type": "shell",
      "command": "pwsh -NoProfile -File scripts/check-fast.ps1",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "GUST: check feature",
      "type": "shell",
      "command": "pwsh -NoProfile -File scripts/check-feature.ps1 -Area ${input:gustFeatureArea}",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "GUST: check examples",
      "type": "shell",
      "command": "pwsh -NoProfile -File scripts/check-examples.ps1",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "GUST: check artifacts",
      "type": "shell",
      "command": "pwsh -NoProfile -File scripts/check-artifacts.ps1",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "GUST: check full",
      "type": "shell",
      "command": "pwsh -NoProfile -File scripts/check-full.ps1",
      "group": "test",
      "problemMatcher": "$rustc"
    }
  ],
  "inputs": [
    {
      "id": "gustFeatureArea",
      "type": "pickString",
      "description": "Focused GUST check area",
      "options": ["macro", "core", "wgpu", "reflection", "loops", "examples", "artifacts", "full"],
      "default": "macro"
    }
  ]
}
