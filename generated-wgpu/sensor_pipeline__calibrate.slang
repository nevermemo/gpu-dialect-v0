// Generated by gpu-dialect from Rust syntax. Slang is the compiler backend.

struct SensorReading
{
    float raw_temperature;
    float raw_humidity;
    uint sensor_id;
    int status;
};

struct Calibration
{
    float temperature_scale;
    float temperature_bias;
    float humidity_scale;
    float humidity_bias;
};

struct CalibratedSample
{
    float temperature;
    float humidity;
    float quality;
    uint sensor_id;
};

struct AlertThresholds
{
    float target_temperature;
    float target_humidity;
    float temperature_weight;
    float humidity_weight;
    float warning;
    float critical;
};

struct Alert
{
    float score;
    float quality;
    uint sensor_id;
    int severity;
};

struct Report
{
    float adjusted_score;
    float confidence;
    uint sensor_id;
    int action;
};

[[vk::binding(0, 0)]] StructuredBuffer<SensorReading> readings;
[[vk::binding(1, 0)]] StructuredBuffer<Calibration> calibration;
[[vk::binding(2, 0)]] RWStructuredBuffer<CalibratedSample> out;

float clamp_value(float value, float low, float high)
{
    var result = value;
    if ((result < low))
    {
        result = low;
    }
    if ((result > high))
    {
        result = high;
    }
    return result;
}

float sample_quality(float humidity)
{
    var centered = (humidity - 0.5);
    return clamp_value((1.0 - (centered * centered)), 0.0, 1.0);
}

float classification_score(CalibratedSample sample, AlertThresholds thresholds)
{
    var temperature_delta = (sample.temperature - thresholds.target_temperature);
    var humidity_delta = (sample.humidity - thresholds.target_humidity);
    var temperature_score = ((temperature_delta * temperature_delta) * thresholds.temperature_weight);
    var humidity_score = ((humidity_delta * humidity_delta) * thresholds.humidity_weight);
    return (temperature_score + humidity_score);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void gpu_sensor_pipeline_calibrate(uint3 id : SV_DispatchThreadID)
{
    uint __gpu_len_readings;
    uint __gpu_stride_readings;
    readings.GetDimensions(__gpu_len_readings, __gpu_stride_readings);
    uint __gpu_len_calibration;
    uint __gpu_stride_calibration;
    calibration.GetDimensions(__gpu_len_calibration, __gpu_stride_calibration);
    uint __gpu_len_out;
    uint __gpu_stride_out;
    out.GetDimensions(__gpu_len_out, __gpu_stride_out);
    var i = id.x;
    if ((i < __gpu_len_out))
    {
        var reading = readings[i];
        var parameters = calibration[i];
        var temperature = ((reading.raw_temperature * parameters.temperature_scale) + parameters.temperature_bias);
        var humidity = clamp_value(((reading.raw_humidity * parameters.humidity_scale) + parameters.humidity_bias), 0.0, 1.0);
        out[i].temperature = temperature;
        out[i].humidity = humidity;
        out[i].quality = sample_quality(humidity);
        out[i].sensor_id = reading.sensor_id;
    }
}
