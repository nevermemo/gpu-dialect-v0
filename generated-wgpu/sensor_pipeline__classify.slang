// Generated by gpu-dialect from Rust syntax. Slang is the compiler backend.

struct SensorReading
{
    float raw_temperature;
    float raw_humidity;
    uint sensor_id;
    int status;
};

struct Calibration
{
    float temperature_scale;
    float temperature_bias;
    float humidity_scale;
    float humidity_bias;
};

struct CalibratedSample
{
    float temperature;
    float humidity;
    float quality;
    uint sensor_id;
};

struct AlertThresholds
{
    float target_temperature;
    float target_humidity;
    float temperature_weight;
    float humidity_weight;
    float warning;
    float critical;
};

struct Alert
{
    float score;
    float quality;
    uint sensor_id;
    int severity;
};

struct Report
{
    float adjusted_score;
    float confidence;
    uint sensor_id;
    int action;
};

[[vk::binding(0, 0)]] StructuredBuffer<CalibratedSample> samples;
[[vk::binding(1, 0)]] StructuredBuffer<AlertThresholds> thresholds;
[[vk::binding(2, 0)]] RWStructuredBuffer<Alert> out;

float clamp_value(float value, float low, float high)
{
    var result = value;
    if ((result < low))
    {
        result = low;
    }
    if ((result > high))
    {
        result = high;
    }
    return result;
}

float sample_quality(float humidity)
{
    var centered = (humidity - 0.5);
    return clamp_value((1.0 - (centered * centered)), 0.0, 1.0);
}

float classification_score(CalibratedSample sample, AlertThresholds thresholds)
{
    var temperature_delta = (sample.temperature - thresholds.target_temperature);
    var humidity_delta = (sample.humidity - thresholds.target_humidity);
    var temperature_score = ((temperature_delta * temperature_delta) * thresholds.temperature_weight);
    var humidity_score = ((humidity_delta * humidity_delta) * thresholds.humidity_weight);
    return (temperature_score + humidity_score);
}

// @rust kernel: sensor_pipeline::classify
[shader("compute")]
[numthreads(64, 1, 1)]
void gpu_sensor_pipeline_classify(uint3 id : SV_DispatchThreadID)
{
    uint __gpu_len_samples;
    uint __gpu_stride_samples;
    samples.GetDimensions(__gpu_len_samples, __gpu_stride_samples);
    uint __gpu_len_thresholds;
    uint __gpu_stride_thresholds;
    thresholds.GetDimensions(__gpu_len_thresholds, __gpu_stride_thresholds);
    uint __gpu_len_out;
    uint __gpu_stride_out;
    out.GetDimensions(__gpu_len_out, __gpu_stride_out);
    var i = id.x;
    if ((i < __gpu_len_out))
    {
        var sample = samples[i];
        var limits = thresholds[i];
        var score = classification_score(sample, limits);
        out[i].score = score;
        out[i].quality = sample.quality;
        out[i].sensor_id = sample.sensor_id;
        if ((score > limits.critical))
        {
            out[i].severity = 2;
        }
        else         if ((score > limits.warning))
        {
            out[i].severity = 1;
        }
        else
        {
            out[i].severity = 0;
        }
    }
}
