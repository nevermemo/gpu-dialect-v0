// @rust kernel: pool::integrate
[shader("compute")]
[numthreads(64, 1, 1)]
void gpu_pool_integrate(uint3 id : SV_DispatchThreadID)
{
    uint __gpu_len_active;
    uint __gpu_stride_active;
    active.GetDimensions(__gpu_len_active, __gpu_stride_active);
    uint __gpu_len_settings;
    uint __gpu_stride_settings;
    settings.GetDimensions(__gpu_len_settings, __gpu_stride_settings);
    uint __gpu_len_particles;
    uint __gpu_stride_particles;
    particles.GetDimensions(__gpu_len_particles, __gpu_stride_particles);
    var i = id.x;
    if (((((uint(0) < __gpu_len_active) && (uint(0) < __gpu_len_settings)) && (i < active[uint(0)].count)) && (i < __gpu_len_particles)))
    {
        var s = settings[uint(0)];
        var p = particles[i];
        p.vy = (p.vy + (s.gravity * s.dt));
        p.x = (p.x + (p.vx * s.dt));
        p.y = (p.y + (p.vy * s.dt));
        p.steps = (p.steps + uint(1));
        particles[i] = p;
