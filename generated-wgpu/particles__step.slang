// Generated by gpu-dialect from Rust syntax. Slang is the compiler backend.

struct Pair
{
    float x;
    float y;
};

struct Particle
{
    Pair position;
    Pair velocity;
    float mass;
    uint tag;
    int charge;
};

[[vk::binding(0, 0)]] StructuredBuffer<Particle> input;
[[vk::binding(1, 0)]] StructuredBuffer<Pair> acceleration;
[[vk::binding(2, 0)]] RWStructuredBuffer<Particle> out;
[[vk::binding(3, 0)]] RWStructuredBuffer<float> energy;

// @rust kernel: particles::step
[shader("compute")]
[numthreads(64, 1, 1)]
void gpu_particles_step(uint3 id : SV_DispatchThreadID)
{
    uint __gpu_len_input;
    uint __gpu_stride_input;
    input.GetDimensions(__gpu_len_input, __gpu_stride_input);
    uint __gpu_len_acceleration;
    uint __gpu_stride_acceleration;
    acceleration.GetDimensions(__gpu_len_acceleration, __gpu_stride_acceleration);
    uint __gpu_len_out;
    uint __gpu_stride_out;
    out.GetDimensions(__gpu_len_out, __gpu_stride_out);
    uint __gpu_len_energy;
    uint __gpu_stride_energy;
    energy.GetDimensions(__gpu_len_energy, __gpu_stride_energy);
    var i = id.x;
    if ((i < __gpu_len_out))
    {
        var particle = input[i];
        var force = acceleration[i];
        var vx = (particle.velocity.x + (force.x * 0.016));
        var vy = (particle.velocity.y + (force.y * 0.016));
        out[i] = particle;
        out[i].velocity.x = vx;
        out[i].velocity.y = vy;
        out[i].position.x = (particle.position.x + (vx * 0.016));
        out[i].position.y = (particle.position.y + (vy * 0.016));
        var speed_squared = ((out[i].velocity.x * out[i].velocity.x) + (out[i].velocity.y * out[i].velocity.y));
        energy[i] = ((speed_squared * particle.mass) * 0.5);
    }
}
