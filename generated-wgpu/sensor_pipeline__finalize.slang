struct SensorReading
{
    float raw_temperature;
    float raw_humidity;
    uint sensor_id;
    int status;
};

struct Calibration
{
    float temperature_scale;
    float temperature_bias;
    float humidity_scale;
    float humidity_bias;
};

struct CalibratedSample
{
    float temperature;
    float humidity;
    float quality;
    uint sensor_id;
};

struct AlertThresholds
{
    float target_temperature;
    float target_humidity;
    float temperature_weight;
    float humidity_weight;
    float warning;
    float critical;
};

struct Alert
{
    float score;
    float quality;
    uint sensor_id;
    int severity;
};

struct Report
{
    float adjusted_score;
    float confidence;
    uint sensor_id;
    int action;
};

[[vk::binding(0, 0)]] StructuredBuffer<Alert> alerts;
[[vk::binding(1, 0)]] RWStructuredBuffer<Report> out;

float clamp_value(float value, float low, float high)
{
    var result = value;
    if ((result < low))
    {
        result = low;
    }
    if ((result > high))
    {
        result = high;
    }
    return result;
}

float sample_quality(float humidity)
{
    var centered = (humidity - 0.5);
    return clamp_value((1.0 - (centered * centered)), 0.0, 1.0);
}

float classification_score(CalibratedSample sample, AlertThresholds thresholds)
{
    var temperature_delta = (sample.temperature - thresholds.target_temperature);
    var humidity_delta = (sample.humidity - thresholds.target_humidity);
    var temperature_score = ((temperature_delta * temperature_delta) * thresholds.temperature_weight);
    var humidity_score = ((humidity_delta * humidity_delta) * thresholds.humidity_weight);
    return (temperature_score + humidity_score);
}

// @rust kernel: sensor_pipeline::finalize
[shader("compute")]
[numthreads(64, 1, 1)]
void gpu_sensor_pipeline_finalize(uint3 id : SV_DispatchThreadID)
{
    uint __gpu_len_alerts;
    uint __gpu_stride_alerts;
    alerts.GetDimensions(__gpu_len_alerts, __gpu_stride_alerts);
    uint __gpu_len_out;
    uint __gpu_stride_out;
    out.GetDimensions(__gpu_len_out, __gpu_stride_out);
    var i = id.x;
    if ((i < __gpu_len_out))
    {
        var alert = alerts[i];
        var quality_penalty = (((1.0 - alert.quality)) * 0.5);
        out[i].adjusted_score = (alert.score + quality_penalty);
        out[i].confidence = alert.quality;
        out[i].sensor_id = alert.sensor_id;
        if (((alert.severity > 0) && (alert.quality < 0.25)))
        {
            out[i].action = (-1);
        }
        else
        {
            out[i].action = alert.severity;
        }
    }
}
